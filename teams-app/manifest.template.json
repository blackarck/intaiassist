{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "0.1.0",
  "id": "{{BOT_APP_ID}}",
  "developer": {
    "name": "{{DEVELOPER_NAME}}",
    "websiteUrl": "https://{{PUBLIC_HOST}}",
    "privacyUrl": "https://{{PUBLIC_HOST}}/privacy",
    "termsOfUseUrl": "https://{{PUBLIC_HOST}}/terms"
  },
  "name": {
    "short": "Interview Assistant",
    "full": "Interview Assistant: private interview coaching"
  },
  "description": {
    "short": "Private coaching for you during your interview.",
    "full": "Interview Assistant sends you private coaching in this chat while your interview is running: suggested follow-up questions, answer scoring against the job description, and a scorecard at the end. It never speaks in the meeting."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#2563EB",
  "bots": [
    {
      "botId": "{{BOT_APP_ID}}",
      "scopes": [
        "personal",
        "groupChat"
      ],
      "isNotificationOnly": false,
      "supportsFiles": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "{{PUBLIC_HOST}}"
  ]
}
