{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": { "defaultValue": {}, "type": "Object" },
    "backendUrl": {
      "type": "String",
      "defaultValue": "https://REPLACE-ME.example.com/api/intake/meeting-invite"
    },
    "intakeToken": { "type": "SecureString", "defaultValue": "" },
    "aliasDomain": { "type": "String", "defaultValue": "example.com" }
  },
  "triggers": {
    "When_a_new_email_arrives_(V3)": {
      "type": "ApiConnection",
      "recurrence": { "frequency": "Minute", "interval": 1 },
      "splitOn": "@triggerBody()?['value']",
      "inputs": {
        "host": {
          "connection": { "name": "@parameters('$connections')['office365']['connectionId']" }
        },
        "method": "get",
        "path": "/v3/Mail/OnNewEmail",
        "queries": {
          "folderPath": "Inbox",
          "importance": "Any",
          "fetchOnlyWithAttachment": false,
          "includeAttachments": true
        }
      }
    }
  },
  "actions": {
    "Only_mail_addressed_to_our_alias_domain": {
      "type": "If",
      "runAfter": {},
      "expression": {
        "and": [
          {
            "contains": [
              "@toLower(concat(coalesce(triggerBody()?['to'], ''), ';', coalesce(triggerBody()?['cc'], '')))",
              "@toLower(parameters('aliasDomain'))"
            ]
          }
        ]
      },
      "actions": {
        "Map_attachments": {
          "type": "Select",
          "runAfter": {},
          "inputs": {
            "from": "@coalesce(triggerBody()?['attachments'], json('[]'))",
            "select": {
              "name": "@item()?['name']",
              "contentType": "@item()?['contentType']",
              "contentBytes": "@item()?['contentBytes']"
            }
          }
        },
        "Forward_to_backend": {
          "type": "Http",
          "runAfter": { "Map_attachments": ["Succeeded"] },
          "inputs": {
            "method": "POST",
            "uri": "@parameters('backendUrl')",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer @{parameters('intakeToken')}"
            },
            "body": {
              "messageId": "@triggerBody()?['id']",
              "from": "@triggerBody()?['from']",
              "to": "@triggerBody()?['to']",
              "cc": "@triggerBody()?['cc']",
              "subject": "@triggerBody()?['subject']",
              "body": "@triggerBody()?['body']",
              "receivedAt": "@triggerBody()?['dateTimeReceived']",
              "attachments": "@body('Map_attachments')"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT5S",
              "maximumInterval": "PT1M"
            }
          }
        }
      },
      "else": { "actions": {} }
    }
  },
  "outputs": {}
}
