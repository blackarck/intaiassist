{
	# No ACME contact e-mail is registered (nothing personal is sent to the certificate authority).
	# Caddy obtains and renews the Let's Encrypt certificate for {$DOMAIN} by itself.
}

(proxy) {
	reverse_proxy backend:3000 {
		health_uri /health
		health_interval 10s
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Inbound e-mail from SendGrid can carry attachments (the backend itself caps it at 12 MB).
	handle /inbound/* {
		request_body {
			max_size 13MB
		}
		import proxy
	}

	# Everything else (Recall webhooks, API) is small.
	handle {
		request_body {
			max_size 6MB
		}
		import proxy
	}
}

# The web app: static files built by the deploy script. Unknown paths fall back to index.html (client-side routes).
{$WEB_DOMAIN} {
	encode zstd gzip
	root * /srv/web

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Scripts only from this site. connect-src: the API and Microsoft sign-in. frame-src: Microsoft's silent sign-in frame.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://{$DOMAIN} https://login.microsoftonline.com; frame-src https://login.microsoftonline.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	# Hashed build assets never change under the same name; the pages themselves must always be re-checked.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
