{
	# No ACME contact e-mail is registered (nothing personal is sent to the certificate authority).
	# Caddy obtains and renews the Let's Encrypt certificate for {$DOMAIN} by itself.
}

{$DOMAIN} {
	encode zstd gzip

	# Recall webhooks and the Logic App payloads are small; refuse anything large.
	request_body {
		max_size 6MB
	}

	reverse_proxy backend:3000 {
		health_uri /health
		health_interval 10s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
