# Backend base URL (no trailing slash)
VITE_API_URL=https://intassistback.askproso.ai
# Microsoft Entra app registration (Application/client id). Authority: "common" accepts work/school accounts of any tenant
# and personal Microsoft accounts.
VITE_MS_CLIENT_ID=
VITE_MS_AUTHORITY=https://login.microsoftonline.com/common
# Local development only: skip sign-in and act as this user (the backend must run with DEV_AUTH=1). Never set in a deployed build.
VITE_DEV_USER=
