# Copy to .env (git-ignored) and fill in. Never commit real values.
INTAKE_TOKEN=change-me-long-random-string
# Microsoft Entra app (client) id used for sign-in. Same value as the web build's VITE_MS_CLIENT_ID. The app registration is
# multi-tenant (any work/school tenant + personal accounts); the backend accepts any tenant's token issued for this app.
MS_CLIENT_ID=
# Subdomain that receives invite e-mail (SendGrid Inbound Parse MX). Interviewers add iv-<alias>@<this> to their meeting.
ALIAS_DOMAIN=invite.example.com

# Recall.ai (https://docs.recall.ai). Credentials are per region.
RECALL_API_KEY=
# us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=
# Workspace verification secret (whsec_...) from the Recall dashboard > Developers > API keys
RECALL_WEBHOOK_SECRET=
# Public https URL of this backend, no trailing slash. Recall posts transcript events to <PUBLIC_BASE_URL>/webhooks/recall
PUBLIC_BASE_URL=

# Optional "support us" payment (Stripe Checkout, fixed $5 / $7 / $10, nothing is gated on it). Leave blank to turn it off.
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_... for testing). Never commit it.
STRIPE_SECRET_KEY=
# Public URL of the web app, no trailing slash: where Stripe sends people back after paying or cancelling
WEB_BASE_URL=

# optional
# BOT_NAME=Interview Assistant
# TRANSCRIPT_LANGUAGE=en

# SendGrid Inbound Parse: secret in the webhook URL (/inbound/sendgrid/<token>). SendGrid does not sign these requests.
INBOUND_TOKEN=
# Require SPF/DKIM pass on inbound mail (default true)
# INBOUND_REQUIRE_AUTH=true
# SQLite file; unset = in-memory (state lost on restart)
# DATABASE_PATH=./data/intassist.db

# Print transcript text to the console. LOCAL DEBUGGING ONLY: transcripts are personal data and must not go to production logs.
# LOG_TRANSCRIPT=1
